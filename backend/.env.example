# ==============================================================================
# StockSense Backend Environment Configuration Template
# Copy this file to backend/.env and replace placeholders with your actual values.
# DO NOT COMMIT REAL SECRETS OR PASSWORDS TO VERSION CONTROL.
# ==============================================================================

# Database Configuration
# Supports Supabase PostgreSQL or local PostgreSQL:
# e.g., postgresql://postgres:[PASSWORD]@[HOST]:[PORT]/postgres
DATABASE_URL=postgresql://postgres:password@localhost:5432/stocksense

# Security & Authentication
SECRET_KEY=your-super-secret-jwt-key-min-32-chars-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Application Settings
API_V1_STR=/api/v1
PROJECT_NAME="StockSense API"
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Optional Supabase Integration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ==============================================================================
# SMTP / Email Provider Configuration (Required for Real OTP Delivery)
# ==============================================================================
# SMTP_HOST: The hostname of your SMTP server
# Examples:
#   - Gmail: smtp.gmail.com
#   - SendGrid: smtp.sendgrid.net
#   - Brevo / Sendinblue: smtp-relay.brevo.com
#   - Amazon SES: email-smtp.us-east-1.amazonaws.com
#   - Mailgun: smtp.mailgun.org
SMTP_HOST=

# SMTP_PORT: Port used by your SMTP provider
#   - 587 for STARTTLS (recommended)
#   - 465 for SSL
#   - 25 or 2525 for unencrypted / alternative relays
SMTP_PORT=587

# SMTP_USER: Username or account email for SMTP authentication
# Examples:
#   - Gmail: your.email@gmail.com
#   - SendGrid: apikey
#   - Brevo: your-account@domain.com
SMTP_USER=

# SMTP_PASSWORD: Password or application-specific token / API key
# For Gmail, generate an "App Password" at https://myaccount.google.com/apppasswords
SMTP_PASSWORD=

# SMTP_TLS: Whether to initiate STARTTLS encryption (true/false)
SMTP_TLS=true

# EMAILS_FROM_EMAIL: The 'From' sender email address displayed on outgoing OTP emails
EMAILS_FROM_EMAIL=noreply@stocksense.io

# EMAILS_FROM_NAME: Friendly sender name
EMAILS_FROM_NAME="StockSense Security"
